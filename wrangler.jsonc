{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cognito-chat",
  // Output of `pnpm pages:build` (@cloudflare/next-on-pages)
  "pages_build_output_dir": ".vercel/output/static",
  // Must be <= the date Cloudflare accepts with nodejs_compat for Pages.
  // next-on-pages requires nodejs_compat or the worker returns 503.
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"]
  // Do NOT put secrets/vars here — they override/clear dashboard Variables & Secrets.
  // Set AUTH_SECRET, AUTH_TRUST_HOST, NEXT_PUBLIC_API_URL, ATLAS_API_KEY in the
  // Cloudflare dashboard: Settings → Variables and Secrets (Production + Preview).
}
