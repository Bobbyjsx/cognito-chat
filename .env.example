# Cognito Unified API Gateway base URL (routes both chat backend and OAuth identity)
# Local dev against staging: https://cognito-api-staging.bobslab.xyz
# Production Cloudflare Worker: https://cognito-api-prod.bobslab.xyz (or https://cognito-api.bobslab.xyz)
NEXT_PUBLIC_API_URL=https://cognito-api-staging.bobslab.xyz

# NextAuth / Auth.js session secret (required at runtime on Cloudflare Workers)
# Generate: openssl rand -base64 32
AUTH_SECRET=your_auth_secret_here

# Trust X-Forwarded-Host from Cloudflare (set true in CF dashboard for Production + Preview)
AUTH_TRUST_HOST=true

# Optional once a custom domain is attached.
# AUTH_URL=https://chat.example.com

# OAuth Client Configuration (authenticates via unified gateway at /api/v1/oauth/*)
NEXT_PUBLIC_OAUTH_CLIENT_ID=app_3580de3409284ef095a1bae03846bd2d
OAUTH_CLIENT_SECRET=your_oauth_client_secret

# Source-map upload token. Unused during local next dev/build (Sentry is off).
SENTRY_AUTH_TOKEN=sntrys_ey
# Force Sentry webpack wrapping on a local production build: SENTRY_ENABLED=1
