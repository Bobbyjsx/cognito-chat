# Cognito API base URL.
# - Direct (local API):        http://127.0.0.1:8001
# - Via Project Atlas gateway: http://127.0.0.1:8080/cognito
#   (Atlas routes /{service}/{path} — service name is "cognito")
NEXT_PUBLIC_API_URL=http://127.0.0.1:8001

# NextAuth / Auth.js session secret
AUTH_SECRET=your_auth_secret_here

# Atlas gateway API key (server-only — never prefix with NEXT_PUBLIC_).
# Sent as header: X-Atlas-Api-Key
# Must match gateway env API_KEY_COGNITO. Leave empty when calling the API directly.
ATLAS_API_KEY=
