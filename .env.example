# Cognito API base URL.
# - Direct (local API):        http://127.0.0.1:8001
# - Via Project Atlas gateway: https://<atlas-host>/cognito
#   Atlas routes /{service}/{path}; service name MUST be "cognito"
#   so the gateway looks up API_KEY_COGNITO.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8001

# NextAuth / Auth.js session secret
AUTH_SECRET=your_auth_secret_here

# Atlas gateway API key — must match gateway env API_KEY_COGNITO
# (GSM secret name: api-key-cognito). Sent as header: X-Atlas-Api-Key
# Prefer ATLAS_API_KEY (server-only). NEXT_PUBLIC_ATLAS_API_KEY also works.
# Leave empty when calling the Cognito API directly (no gateway).
ATLAS_API_KEY=
NEXT_PUBLIC_ATLAS_API_KEY=
