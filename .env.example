# Cognito API base URL.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8001

# NextAuth / Auth.js session secret (required at runtime on Cloudflare Workers)
# Generate: openssl rand -base64 32
AUTH_SECRET=your_auth_secret_here

# Trust X-Forwarded-Host from Cloudflare (set true in CF dashboard for Production + Preview)
AUTH_TRUST_HOST=true

# Optional once a custom domain is attached.
# AUTH_URL=https://chat.example.com


# OAuth Service Configuration
# Direct: http://localhost:8002 | Gateway: https://<atlas-host>/identity
NEXT_PUBLIC_OAUTH_SERVICE_URL=http://localhost:8002
NEXT_PUBLIC_OAUTH_CLIENT_ID=cognito
OAUTH_CLIENT_SECRET=OF_

SENTRY_AUTH_TOKEN=sntrys_ey
