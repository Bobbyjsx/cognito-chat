{
  "name": "cognito-chat",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "CLOUDFLARE=1 opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "CLOUDFLARE=1 opennextjs-cloudflare build && opennextjs-cloudflare deploy -- --keep-vars",
    "upload": "CLOUDFLARE=1 opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv --include-runtime false cloudflare-env.d.ts",
    "start": "next start",
    "lint": "npx eslint",
    "lint:fix": "npx eslint . --fix && npx prettier . --write",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "npx eslint --fix",
      "npx prettier --write"
    ],
    "*.{json,css,md,yml,yaml}": [
      "npx prettier --write"
    ]
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.238",
    "@base-ui/react": "^1.6.0",
    "@gsap/react": "^2.1.2",
    "@hookform/resolvers": "^5.5.7",
    "@opennextjs/cloudflare": "^1.20.2",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-use-controllable-state": "^1.2.6",
    "@sentry/nextjs": "^10",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@tanstack/react-virtual": "^3.14.9",
    "ai": "^6.0.236",
    "axios": "^1.18.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.43.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.27.0",
    "motion": "^12.43.0",
    "nanoid": "^6.0.0",
    "next": "16.2.12",
    "next-auth": "^5.0.0-beta.32",
    "next-nprogress-bar": "^2.4.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.83.0",
    "react-plock": "^3.6.1",
    "react-resizable-panels": "^4.12.3",
    "shadcn": "^4.16.0",
    "shiki": "^4.3.1",
    "sonner": "^2.0.7",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "tokenlens": "^1.3.1",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.123.0"
  }
